NODE_ENV=development
SERVICE_NAME=store-management-api
PORT=3000
LOG_LEVEL=debug
HTTP_LOGGING_ENABLED=true
API_PREFIX=api
API_DEFAULT_VERSION=1

# Local replica set is required for multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/store_management?replicaSet=rs0
MONGODB_DB_NAME=store_management
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_CONNECTING=2
MONGODB_MAX_IDLE_TIME_MS=60000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_RETRY_ATTEMPTS=5
MONGODB_RETRY_DELAY_MS=3000
